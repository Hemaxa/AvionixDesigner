QMainWindow#MainWindow,
QWidget {
    background-color: #eef2f6;
    color: #1f2937;
    font-family: "SF Pro Display", "Segoe UI", sans-serif;
    font-size: 13px;
}

#EditorWorkspacePanel,
#SelectionToolStrip {
    background-color: transparent;
    border: none;
}

#ViewportPanel {
    background-color: #dde7f0;
    border: 1px solid #2f6fed;
    border-radius: 10px;
}

#ObjectListPanel,
#ObjectPropertiesPanel,
#ObjectLibraryPanel,
#ViewportSettingsPanel {
    background-color: #eef2f6;
    border: none;
}

QDockWidget {
    font-weight: 600;
    border: 1px solid #cdd7e3;
    border-radius: 10px;
}

QDockWidget::title {
    background-color: #f7f9fc;
    color: #111827;
    padding: 8px 12px;
    border-bottom: 1px solid #d7dfeb;
}

QDockWidget::close-button,
QDockWidget::float-button {
    padding: 2px;
    border-radius: 5px;
}

QDockWidget::close-button:hover,
QDockWidget::float-button:hover {
    background-color: #e6edf7;
}

QMenuBar {
    background-color: #f8fafc;
    border-bottom: 1px solid #d6deea;
    padding: 4px 6px;
}

QMenuBar::item {
    padding: 6px 10px;
    border-radius: 8px;
}

QMenuBar::item:selected {
    background-color: #2f6fed;
    color: #ffffff;
}

QMenu {
    background-color: #ffffff;
    border: 1px solid #d6deea;
    padding: 6px;
}

QMenu::item {
    padding: 8px 14px;
    border-radius: 8px;
}

QMenu::item:selected {
    background-color: #2f6fed;
    color: #ffffff;
}

QMenu::separator {
    height: 1px;
    background-color: #d6deea;
    margin: 6px 8px;
}

#ObjectListWidget {
    background-color: #ffffff;
    border: 1px solid #d6deea;
    border-radius: 10px;
    outline: none;
    padding: 4px;
}

QListWidget::item {
    background-color: transparent;
    margin: 2px 0;
    padding: 8px 10px;
    border-radius: 8px;
}

QListWidget::item:hover {
    background-color: #edf3fb;
}

QListWidget::item:selected {
    background-color: #2f6fed;
    color: #ffffff;
}

#PropertiesTitleLabel,
#PropertiesEmptyTitleLabel,
#SettingsFieldLabel {
    color: #111827;
    font-size: 14px;
    font-weight: 700;
}

#PropertiesEmptyTextLabel,
#SettingsSizeLabel {
    color: #5b6778;
}

#LibraryCard,
#PropertiesEmptyState,
#PropertiesTableCard,
#SettingsCard,
#SelectionToolButton {
    background-color: #ffffff;
    border: 1px solid #d6deea;
    border-radius: 10px;
}

#LibraryCard {
    padding: 4px;
}

#LibraryCard:hover,
#SelectionToolButton:hover {
    background-color: #f6f9fd;
    border-color: #2f6fed;
}

#LibraryCard:pressed,
#SelectionToolButton:pressed {
    background-color: #ecf2fb;
}

#PropertiesContainer {
    background-color: transparent;
}

#PropertiesTable {
    background-color: transparent;
    border: none;
    gridline-color: transparent;
    selection-background-color: #2f6fed;
    selection-color: #ffffff;
}

#PropertiesTable::item {
    padding: 9px 12px;
    border-bottom: 1px solid #edf1f7;
}

#PropertiesTable::item:selected {
    background-color: #2f6fed;
    color: #ffffff;
}

QHeaderView::section {
    background-color: #f4f7fb;
    color: #334155;
    border: none;
    border-bottom: 1px solid #dbe3ef;
    padding: 9px 12px;
    font-weight: 650;
}

QLineEdit,
QTextEdit,
QSpinBox {
    background-color: #ffffff;
    color: #1f2937;
    border: 1px solid #d6deea;
    border-radius: 9px;
    padding: 7px 10px;
}

QLineEdit:focus,
QTextEdit:focus,
QSpinBox:focus {
    border-color: #2f6fed;
}

QPushButton,
QToolButton {
    background-color: #ffffff;
    color: #1f2937;
    border: 1px solid #c9d5e4;
    border-radius: 9px;
    padding: 8px 12px;
}

QPushButton:hover,
QToolButton:hover {
    background-color: #f4f8ff;
    border-color: #2f6fed;
}

QPushButton:pressed,
QToolButton:pressed {
    background-color: #e9f0fb;
}

#SettingsColorButton {
    padding: 0px;
    min-width: 28px;
    min-height: 28px;
}

#SelectionToolButton {
    padding: 0px;
    font-size: 11px;
    font-weight: 700;
}

QScrollBar:vertical {
    background-color: transparent;
    width: 10px;
    margin: 6px 0;
}

QScrollBar::handle:vertical {
    background-color: #c4ceda;
    border-radius: 5px;
    min-height: 28px;
}

QScrollBar::handle:vertical:hover {
    background-color: #2f6fed;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical,
QScrollBar:horizontal,
QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal,
QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: transparent;
    border: none;
    height: 0;
    width: 0;
}
