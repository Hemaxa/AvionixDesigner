QMainWindow#MainWindow,
QWidget {
    background-color: #eef2f6;
    color: #1f2937;
    font-family: "SF Pro Display", "Segoe UI", sans-serif;
    font-size: 13px;
}

#ViewportPanel {
    background-color: #dde7f0;
    border: 1px solid #2f6fed;
    border-radius: 12px;
}

#ObjectListPanel,
#ObjectPropertiesPanel,
#ObjectLibraryPanel,
#ViewportSettingsPanel {
    background-color: #eef2f6;
    border: none;
}

QDockWidget {
    font-weight: 600;
    border: 1px solid #cdd7e3;
    border-radius: 12px;
}

QDockWidget::title {
    background-color: #f7f9fc;
    color: #111827;
    padding: 10px 14px;
    border-bottom: 1px solid #d7dfeb;
}

QDockWidget::close-button,
QDockWidget::float-button {
    padding: 2px;
    border-radius: 6px;
}

QDockWidget::close-button:hover,
QDockWidget::float-button:hover {
    background-color: #e6edf7;
}

QMenuBar {
    background-color: #f8fafc;
    border-bottom: 1px solid #d6deea;
    padding: 4px 6px;
}

QMenuBar::item {
    padding: 6px 10px;
    border-radius: 8px;
}

QMenuBar::item:selected {
    background-color: #2f6fed;
    color: #ffffff;
}

QMenu {
    background-color: #ffffff;
    border: 1px solid #d6deea;
    padding: 6px;
}

QMenu::item {
    padding: 8px 14px;
    border-radius: 8px;
}

QMenu::item:selected {
    background-color: #2f6fed;
    color: #ffffff;
}

QMenu::separator {
    height: 1px;
    background-color: #d6deea;
    margin: 6px 8px;
}

#ObjectListWidget {
    background-color: #ffffff;
    border: 1px solid #d6deea;
    border-radius: 14px;
    outline: none;
    padding: 6px;
}

QListWidget::item {
    background-color: transparent;
    margin: 2px 0;
    padding: 10px 12px;
    border-radius: 10px;
}

QListWidget::item:hover {
    background-color: #edf3fb;
}

QListWidget::item:selected {
    background-color: #2f6fed;
    color: #ffffff;
}

#LibraryTitleLabel,
#PropertiesTitleLabel {
    color: #111827;
    font-size: 15px;
    font-weight: 700;
}

#LibraryDescriptionLabel,
#PropertiesSubtitleLabel,
#PropertiesEmptyTextLabel {
    color: #5b6778;
    line-height: 1.4em;
}

#LibraryCard {
    background-color: #ffffff;
    border: 1px solid #d6deea;
    border-radius: 14px;
    padding: 6px;
    text-align: center;
    font-weight: 600;
}

#LibraryCard:hover {
    background-color: #f6f9fd;
    border-color: #2f6fed;
}

#LibraryCard:pressed {
    background-color: #ecf2fb;
}

#PropertiesContainer {
    background-color: transparent;
}

#PropertiesEmptyState,
#PropertiesTableCard {
    background-color: #ffffff;
    border: 1px solid #d6deea;
    border-radius: 16px;
}

#PropertiesEmptyTitleLabel {
    color: #111827;
    font-size: 15px;
    font-weight: 650;
}

#PropertiesTable {
    background-color: transparent;
    border: none;
    gridline-color: transparent;
    selection-background-color: #2f6fed;
    selection-color: #ffffff;
}

#PropertiesTable::item {
    padding: 10px 12px;
    border-bottom: 1px solid #edf1f7;
}

#PropertiesTable::item:selected {
    background-color: #2f6fed;
    color: #ffffff;
}

QHeaderView::section {
    background-color: #f4f7fb;
    color: #334155;
    border: none;
    border-bottom: 1px solid #dbe3ef;
    padding: 10px 12px;
    font-weight: 650;
}

QLineEdit,
QTextEdit {
    background-color: #ffffff;
    color: #1f2937;
    border: 1px solid #d6deea;
    border-radius: 10px;
    padding: 8px 10px;
}

QLineEdit:focus,
QTextEdit:focus {
    border-color: #2f6fed;
}

QPushButton {
    background-color: #ffffff;
    color: #1f2937;
    border: 1px solid #c9d5e4;
    border-radius: 10px;
    padding: 8px 14px;
}

QPushButton:hover {
    background-color: #f4f8ff;
    border-color: #2f6fed;
}

QPushButton:pressed {
    background-color: #e9f0fb;
}

QScrollBar:vertical {
    background-color: transparent;
    width: 12px;
    margin: 6px 0;
}

QScrollBar::handle:vertical {
    background-color: #c4ceda;
    border-radius: 6px;
    min-height: 28px;
}

QScrollBar::handle:vertical:hover {
    background-color: #2f6fed;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical,
QScrollBar:horizontal,
QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal,
QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: transparent;
    border: none;
    height: 0;
    width: 0;
}
