QMainWindow#MainWindow,
QWidget {
    background-color: #252a33;
    color: #edf2f7;
    font-family: "SF Pro Display", "Segoe UI", sans-serif;
    font-size: 13px;
}

#ViewportPanel {
    background-color: #131722;
    border: 1px solid #5fa4ff;
    border-radius: 12px;
}

#ObjectListPanel,
#ObjectPropertiesPanel,
#ObjectLibraryPanel,
#ViewportSettingsPanel {
    background-color: #252a33;
    border: none;
}

QDockWidget {
    font-weight: 600;
    border: 1px solid #3b4657;
    border-radius: 12px;
}

QDockWidget::title {
    background-color: #2d3440;
    color: #f8fbff;
    padding: 10px 14px;
    border-bottom: 1px solid #3f4b5f;
}

QDockWidget::close-button,
QDockWidget::float-button {
    padding: 2px;
    border-radius: 6px;
}

QDockWidget::close-button:hover,
QDockWidget::float-button:hover {
    background-color: #3a4354;
}

QMenuBar {
    background-color: #1e232c;
    border-bottom: 1px solid #344054;
    padding: 4px 6px;
}

QMenuBar::item {
    padding: 6px 10px;
    border-radius: 8px;
}

QMenuBar::item:selected {
    background-color: #5fa4ff;
    color: #08111f;
}

QMenu {
    background-color: #2a303c;
    border: 1px solid #3b4657;
    padding: 6px;
}

QMenu::item {
    padding: 8px 14px;
    border-radius: 8px;
}

QMenu::item:selected {
    background-color: #5fa4ff;
    color: #08111f;
}

QMenu::separator {
    height: 1px;
    background-color: #3b4657;
    margin: 6px 8px;
}

#ObjectListWidget {
    background-color: #202632;
    border: 1px solid #364152;
    border-radius: 14px;
    outline: none;
    padding: 6px;
}

QListWidget::item {
    background-color: transparent;
    margin: 2px 0;
    padding: 10px 12px;
    border-radius: 10px;
}

QListWidget::item:hover {
    background-color: #2f3745;
}

QListWidget::item:selected {
    background-color: #5fa4ff;
    color: #08111f;
}

#LibraryTitleLabel,
#PropertiesTitleLabel {
    color: #f8fbff;
    font-size: 16px;
    font-weight: 700;
}

#LibraryDescriptionLabel,
#PropertiesSubtitleLabel,
#PropertiesEmptyTextLabel {
    color: #aeb9c9;
    line-height: 1.4em;
}

#LibraryCard {
    background-color: #1f2530;
    border: 1px solid #364152;
    border-radius: 18px;
    padding: 14px 12px;
    text-align: center;
    font-weight: 600;
}

#LibraryCard:hover {
    background-color: #27303d;
    border-color: #5fa4ff;
}

#LibraryCard:pressed {
    background-color: #1c2330;
}

#PropertiesContainer {
    background-color: transparent;
}

#PropertiesEmptyState,
#PropertiesTableCard {
    background-color: #1f2530;
    border: 1px solid #364152;
    border-radius: 16px;
}

#PropertiesEmptyTitleLabel {
    color: #f8fbff;
    font-size: 15px;
    font-weight: 650;
}

#PropertiesTable {
    background-color: transparent;
    border: none;
    gridline-color: transparent;
    selection-background-color: #5fa4ff;
    selection-color: #08111f;
}

#PropertiesTable::item {
    padding: 10px 12px;
    border-bottom: 1px solid #2f3745;
}

#PropertiesTable::item:selected {
    background-color: #5fa4ff;
    color: #08111f;
}

QHeaderView::section {
    background-color: #27303d;
    color: #dce6f5;
    border: none;
    border-bottom: 1px solid #364152;
    padding: 10px 12px;
    font-weight: 650;
}

QLineEdit,
QTextEdit {
    background-color: #1f2530;
    color: #edf2f7;
    border: 1px solid #364152;
    border-radius: 10px;
    padding: 8px 10px;
}

QLineEdit:focus,
QTextEdit:focus {
    border-color: #5fa4ff;
}

QPushButton {
    background-color: #2c3441;
    color: #edf2f7;
    border: 1px solid #3e4a5d;
    border-radius: 10px;
    padding: 8px 14px;
}

QPushButton:hover {
    background-color: #364152;
    border-color: #5fa4ff;
}

QPushButton:pressed {
    background-color: #202733;
}

QScrollBar:vertical {
    background-color: transparent;
    width: 12px;
    margin: 6px 0;
}

QScrollBar::handle:vertical {
    background-color: #465266;
    border-radius: 6px;
    min-height: 28px;
}

QScrollBar::handle:vertical:hover {
    background-color: #5fa4ff;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical,
QScrollBar:horizontal,
QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal,
QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: transparent;
    border: none;
    height: 0;
    width: 0;
}
