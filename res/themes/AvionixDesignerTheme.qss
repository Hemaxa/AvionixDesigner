/*
    Палитра Avionix Designer

    Поверхности:
    #0f141a - общий фон приложения
    #121922 - панели, списки, меню, карточки
    #17212b - заголовки, hover, выбранные строки
    #0a0f14 - рабочая область холста

    Границы:
    #22303c - обычные границы
    #334656 - усиленные границы и чекбоксы

    Текст:
    #edf7fb - основной текст и заголовки
    #9fb3c1 - вторичный текст

    Акценты:
    #00c8f0 - основной циановый акцент
    #061116 - текст на циановом акценте
    #8bdff2 - мягкий голубой для меток типов
    #063847 - фон активных переключателей
    #ff5c7a - опасное действие
*/

QMainWindow#MainWindow,
QWidget {
    background-color: #0f141a;
    color: #edf7fb;
    selection-background-color: #00c8f0;
    selection-color: #061116;
    font-family: "SF Pro Display", "Segoe UI", "Arial", sans-serif;
    font-size: 13px;
}

#EditorWorkspacePanel,
#SelectionToolStrip,
#ObjectListPanel,
#ObjectPropertiesPanel,
#ObjectLibraryPanel,
#ViewportSettingsPanel,
#SettingsCard,
#PropertiesTableCard,
#PropertiesEmptyState,
#PropertiesContainer {
    background-color: transparent;
    border: none;
}

#ViewportPanel {
    background-color: #0a0f14;
    border: 1px solid #22303c;
    border-radius: 8px;
}

QDockWidget {
    font-weight: 600;
    border: 1px solid #22303c;
    border-radius: 8px;
}

QDockWidget::title {
    background-color: #17212b;
    color: #edf7fb;
    padding: 8px 12px;
    border-bottom: 1px solid #22303c;
}

QDockWidget::close-button,
QDockWidget::float-button,
#ObjectListIconButton {
    padding: 2px;
    border-radius: 6px;
}

QDockWidget::close-button:hover,
QDockWidget::float-button:hover,
#ObjectListIconButton:hover {
    background-color: #17212b;
}

QMenuBar {
    background-color: #121922;
    border-bottom: 1px solid #22303c;
    padding: 4px 6px;
}

QMenuBar::item {
    padding: 6px 10px;
    border-radius: 6px;
}

QMenuBar::item:selected,
QMenu::item:selected {
    background-color: #00c8f0;
    color: #061116;
}

QMenu {
    background-color: #121922;
    border: 1px solid #22303c;
    padding: 6px;
}

QMenu::item {
    padding: 8px 14px;
    border-radius: 6px;
}

QMenu::separator {
    height: 1px;
    background-color: #22303c;
    margin: 6px 8px;
}

QListWidget {
    background-color: #121922;
    border: 1px solid #22303c;
    border-radius: 8px;
    outline: none;
    padding: 4px;
}

#ObjectListWidget {
    min-width: 180px;
}

QListWidget::item {
    background-color: transparent;
    border: 1px solid transparent;
    margin: 1px 3px;
    padding: 0;
    border-radius: 4px;
}

QListWidget::item:hover {
    background-color: #17212b;
}

QListWidget::item:selected {
    background-color: #17212b;
    border: 1px solid #00c8f0;
    color: #edf7fb;
}

#ObjectListRowWidget,
#ObjectListGroupRowWidget {
    background-color: transparent;
    border: none;
}

#ObjectListIconButton {
    background-color: transparent;
    border: none;
    padding: 0;
    border-radius: 4px;
}

#ObjectListRowLabel {
    background-color: transparent;
    color: #edf7fb;
    padding: 0;
}

#ObjectListTypeLabel {
    background-color: transparent;
    color: #8bdff2;
    padding: 0;
    font-size: 11px;
}

QCheckBox {
    background-color: transparent;
    color: #edf7fb;
    spacing: 4px;
    min-height: 20px;
}

QCheckBox::indicator {
    width: 14px;
    height: 14px;
    border: 1px solid #334656;
    border-radius: 3px;
    background-color: #121922;
}

QCheckBox::indicator:hover {
    border-color: #00c8f0;
}

QCheckBox::indicator:checked {
    background-color: #00c8f0;
    border-color: #00c8f0;
}

#ObjectExportCheck {
    spacing: 4px;
}

#PropertiesTitleLabel,
#PropertiesEmptyTitleLabel {
    color: #edf7fb;
    font-size: 14px;
    font-weight: 700;
}

#PropertiesSubtitleLabel,
#PropertiesEmptyTextLabel {
    color: #9fb3c1;
}

#LibraryCard,
#SelectionToolButton,
#SettingsToolButton {
    background-color: #121922;
    border: 1px solid #22303c;
    border-radius: 8px;
}

#LibraryCard {
    padding: 0;
}

#LibraryCard:hover,
#SelectionToolButton:hover,
#SettingsToolButton:hover {
    background-color: #17212b;
    border-color: #00c8f0;
}

#LibraryCard:pressed,
#SelectionToolButton:pressed,
#SettingsToolButton:pressed {
    background-color: #0a0f14;
}

#SettingsToolButton:checked {
    background-color: #063847;
    border-color: #00c8f0;
}

#SelectionToolButton,
#SettingsToolButton {
    padding: 0;
    font-size: 11px;
    font-weight: 700;
}

QTableWidget,
#PropertiesTable {
    background-color: transparent;
    border: none;
    gridline-color: transparent;
    selection-background-color: #00c8f0;
    selection-color: #061116;
}

QTableWidget::item,
#PropertiesTable::item {
    padding: 8px 10px;
    border-bottom: 1px solid #22303c;
}

QTableWidget::item:selected,
#PropertiesTable::item:selected {
    background-color: #00c8f0;
    color: #061116;
}

QHeaderView::section {
    background-color: #17212b;
    color: #edf7fb;
    border: none;
    border-bottom: 1px solid #22303c;
    padding: 8px 10px;
    font-weight: 650;
}

QGroupBox {
    background-color: #121922;
    border: 1px solid #22303c;
    border-radius: 8px;
    margin-top: 16px;
    padding: 14px 12px 12px 12px;
    font-weight: 650;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 10px;
    padding: 0 6px;
    color: #edf7fb;
    background-color: #0f141a;
}

QLabel {
    background-color: transparent;
}

QLineEdit,
QTextEdit,
QSpinBox,
QComboBox {
    background-color: #121922;
    color: #edf7fb;
    border: 1px solid #22303c;
    border-radius: 7px;
    min-height: 28px;
    padding: 6px 9px;
}

QLineEdit:focus,
QTextEdit:focus,
QSpinBox:focus,
QComboBox:focus {
    border-color: #00c8f0;
}

QPushButton,
QToolButton {
    background-color: #121922;
    color: #edf7fb;
    border: 1px solid #22303c;
    border-radius: 7px;
    min-height: 28px;
    padding: 7px 12px;
}

QPushButton:hover,
QToolButton:hover {
    background-color: #17212b;
    border-color: #00c8f0;
}

QPushButton:pressed,
QToolButton:pressed {
    background-color: #0a0f14;
}

QToolButton#LibraryCard {
    min-width: 56px;
    max-width: 56px;
    min-height: 56px;
    max-height: 56px;
    padding: 0;
    qproperty-iconSize: 32px 32px;
}

QToolButton#SelectionToolButton,
QToolButton#SettingsToolButton,
QPushButton#SettingsColorButton {
    min-width: 48px;
    max-width: 48px;
    min-height: 48px;
    max-height: 48px;
    padding: 0;
}

QToolButton#SelectionToolButton,
QToolButton#SettingsToolButton {
    qproperty-iconSize: 24px 24px;
}

QPushButton#SettingsColorButton {
    qproperty-iconSize: 28px 28px;
}

QPushButton#ResetButton {
    color: #ff5c7a;
    border-color: #334656;
}

QPushButton#ResetButton:hover {
    background-color: #17212b;
    border-color: #ff5c7a;
}

QPushButton#ColorSwatchButton {
    min-width: 34px;
    max-width: 34px;
    min-height: 28px;
    max-height: 28px;
    padding: 0;
}

QDialog#SettingsWindow QListWidget {
    min-width: 168px;
}

QDialog#SettingsWindow QFormLayout QLabel,
QDialog QLabel {
    color: #edf7fb;
}

QDialogButtonBox QPushButton {
    min-width: 84px;
}

QScrollArea {
    background-color: transparent;
    border: none;
}

QScrollBar:vertical {
    background-color: transparent;
    width: 10px;
    margin: 6px 0;
}

QScrollBar::handle:vertical {
    background-color: #334656;
    border-radius: 5px;
    min-height: 28px;
}

QScrollBar::handle:vertical:hover {
    background-color: #00c8f0;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical,
QScrollBar:horizontal,
QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal,
QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: transparent;
    border: none;
    height: 0;
    width: 0;
}
