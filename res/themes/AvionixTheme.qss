QMainWindow#MainWindow,
QWidget {
    background-color: #14181d;
    color: #eef7ff;
    font-family: "SF Pro Display", "Segoe UI", sans-serif;
    font-size: 13px;
}

#ViewportPanel {
    background-color: #0b1014;
    border: 1px solid #00d4ff;
    border-radius: 12px;
}

#ObjectListPanel,
#ObjectPropertiesPanel,
#ObjectLibraryPanel,
#ViewportSettingsPanel {
    background-color: #14181d;
    border: none;
}

QDockWidget {
    font-weight: 600;
    border: 1px solid #26313a;
    border-radius: 12px;
}

QDockWidget::title {
    background-color: #1a2027;
    color: #f3fbff;
    padding: 10px 14px;
    border-bottom: 1px solid #31404b;
}

QDockWidget::close-button,
QDockWidget::float-button {
    padding: 2px;
    border-radius: 6px;
}

QDockWidget::close-button:hover,
QDockWidget::float-button:hover {
    background-color: #24323d;
}

QMenuBar {
    background-color: #10151a;
    border-bottom: 1px solid #26333c;
    padding: 4px 6px;
}

QMenuBar::item {
    padding: 6px 10px;
    border-radius: 8px;
}

QMenuBar::item:selected {
    background-color: #00d4ff;
    color: #041014;
}

QMenu {
    background-color: #161d24;
    border: 1px solid #2b3944;
    padding: 6px;
}

QMenu::item {
    padding: 8px 14px;
    border-radius: 8px;
}

QMenu::item:selected {
    background-color: #00d4ff;
    color: #041014;
}

QMenu::separator {
    height: 1px;
    background-color: #2b3944;
    margin: 6px 8px;
}

#ObjectListWidget {
    background-color: #12181e;
    border: 1px solid #27333c;
    border-radius: 14px;
    outline: none;
    padding: 6px;
}

QListWidget::item {
    background-color: transparent;
    margin: 2px 0;
    padding: 10px 12px;
    border-radius: 10px;
}

QListWidget::item:hover {
    background-color: #1d2730;
}

QListWidget::item:selected {
    background-color: #00d4ff;
    color: #041014;
}

#LibraryTitleLabel,
#PropertiesTitleLabel {
    color: #f3fbff;
    font-size: 15px;
    font-weight: 700;
}

#LibraryDescriptionLabel,
#PropertiesSubtitleLabel,
#PropertiesEmptyTextLabel {
    color: #91a7b7;
    line-height: 1.4em;
}

#LibraryCard {
    background-color: #10161c;
    border: 1px solid #23303a;
    border-radius: 14px;
    padding: 6px;
    text-align: center;
    font-weight: 600;
}

#LibraryCard:hover {
    background-color: #15202a;
    border-color: #00d4ff;
}

#LibraryCard:pressed {
    background-color: #0d141a;
}

#PropertiesContainer {
    background-color: transparent;
}

#PropertiesEmptyState,
#PropertiesTableCard {
    background-color: #10161c;
    border: 1px solid #23303a;
    border-radius: 16px;
}

#PropertiesEmptyTitleLabel {
    color: #f3fbff;
    font-size: 15px;
    font-weight: 650;
}

#PropertiesTable {
    background-color: transparent;
    border: none;
    gridline-color: transparent;
    selection-background-color: #00d4ff;
    selection-color: #041014;
}

#PropertiesTable::item {
    padding: 10px 12px;
    border-bottom: 1px solid #1b2730;
}

#PropertiesTable::item:selected {
    background-color: #00d4ff;
    color: #041014;
}

QHeaderView::section {
    background-color: #15202a;
    color: #d7edf8;
    border: none;
    border-bottom: 1px solid #23303a;
    padding: 10px 12px;
    font-weight: 650;
}

QLineEdit,
QTextEdit {
    background-color: #11181e;
    color: #eef7ff;
    border: 1px solid #27333c;
    border-radius: 10px;
    padding: 8px 10px;
}

QLineEdit:focus,
QTextEdit:focus {
    border-color: #00d4ff;
}

QPushButton {
    background-color: #18212a;
    color: #eef7ff;
    border: 1px solid #2b3944;
    border-radius: 10px;
    padding: 8px 14px;
}

QPushButton:hover {
    background-color: #1f2a34;
    border-color: #00d4ff;
}

QPushButton:pressed {
    background-color: #0f171d;
}

QScrollBar:vertical {
    background-color: transparent;
    width: 12px;
    margin: 6px 0;
}

QScrollBar::handle:vertical {
    background-color: #334551;
    border-radius: 6px;
    min-height: 28px;
}

QScrollBar::handle:vertical:hover {
    background-color: #00d4ff;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical,
QScrollBar:horizontal,
QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal,
QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: transparent;
    border: none;
    height: 0;
    width: 0;
}
