/*
 * Avionix Designer Theme
 * 
 * Тёмная тема с яркими голубыми акцентами
 * 
 * Основные цвета:
 * - Фон: #1e1e1e
 * - Текст: #e0e0e0
 * - Акцент: #00d4ff (яркий циан)
 * - Границы: #00d4ff (акцентные) / #2a2a2a (обычные)
 * - Hover: #3a3a3a
 */

/* ===== Основные виджеты ===== */

QMainWindow#MainWindow,
QWidget {
    background-color: #1e1e1e;
    color: #e0e0e0;
}

/* ===== Базовые панели ===== */

#ViewportPanel {
    background-color: #151515;
    border: 1px solid #00d4ff;
}

#ObjectListPanel {
    background-color: #1e1e1e;
    border: none;
}

#ObjectPropertiesPanel {
    background-color: #1e1e1e;
    border: none;
}

#ObjectLibraryPanel {
    background-color: #1a1a1a;
    border: 1px solid #2a2a2a;
}

#ViewportSettingsPanel {
    background-color: #1a1a1a;
    border: 1px solid #2a2a2a;
}

/* ===== Dock-панели ===== */

QDockWidget {
    titlebar-close-icon: none;
    titlebar-normal-icon: none;
    font-weight: bold;
    border: 1px solid #00d4ff;
}

QDockWidget::title {
    background-color: #252525;
    padding: 8px;
    border-bottom: 2px solid #00d4ff;
}

QDockWidget::close-button,
QDockWidget::float-button {
    padding: 0px;
    icon-size: 14px;
}

QDockWidget::close-button:hover,
QDockWidget::float-button:hover {
    background-color: #00d4ff;
    border-radius: 2px;
}

/* ===== Меню ===== */

QMenuBar {
    background-color: #1e1e1e;
    border-bottom: 1px solid #00d4ff;
    padding: 2px;
}

QMenuBar::item {
    padding: 4px 8px;
    border-radius: 4px;
}

QMenuBar::item:selected {
    background-color: #00d4ff;
    color: #000000;
}

QMenu {
    background-color: #252525;
    border: 1px solid #00d4ff;
    padding: 4px;
}

QMenu::item {
    padding: 6px 24px 6px 12px;
    border-radius: 4px;
}

QMenu::item:selected {
    background-color: #00d4ff;
    color: #000000;
}

QMenu::separator {
    height: 1px;
    background-color: #2a2a2a;
    margin: 4px 8px;
}

/* ===== Списки ===== */

QListWidget,
#ObjectListWidget {
    background-color: #1a1a1a;
    border: 1px solid #2a2a2a;
    outline: none;
}

QListWidget::item {
    padding: 6px 8px;
    border-radius: 4px;
}

QListWidget::item:hover {
    background-color: #2a2a2a;
}

QListWidget::item:selected {
    background-color: #00d4ff;
    color: #000000;
}

/* ===== Текстовые поля ===== */

QTextEdit {
    background-color: #151515;
    color: #d4d4d4;
    border: 1px solid #2a2a2a;
    font-family: "Menlo", "Monaco", "Consolas", monospace;
    font-size: 11px;
    selection-background-color: #00d4ff;
}

QTextEdit:focus {
    border-color: #00d4ff;
}

QLineEdit {
    background-color: #1a1a1a;
    color: #e0e0e0;
    border: 1px solid #2a2a2a;
    border-radius: 4px;
    padding: 4px 8px;
}

QLineEdit:focus {
    border-color: #00d4ff;
    border-width: 2px;
}

/* ===== Метки ===== */

QLabel {
    color: #e0e0e0;
}

#PropertiesTitleLabel {
    font-weight: bold;
    font-size: 13px;
    padding: 4px 0;
    color: #00d4ff;
}

#LibraryPlaceholderLabel,
#SettingsPlaceholderLabel {
    color: #606060;
    font-style: italic;
}

/* ===== Полосы прокрутки ===== */

QScrollBar:vertical {
    background-color: #1e1e1e;
    width: 12px;
    border: none;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background-color: #00d4ff;
    min-height: 24px;
    border-radius: 4px;
    margin: 2px;
}

QScrollBar::handle:vertical:hover {
    background-color: #33ddff;
}

QScrollBar::handle:vertical:pressed {
    background-color: #00a8cc;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: none;
}

QScrollBar:horizontal {
    background-color: #1e1e1e;
    height: 12px;
    border: none;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background-color: #00d4ff;
    min-width: 24px;
    border-radius: 4px;
    margin: 2px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #33ddff;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0px;
}

/* ===== Кнопки ===== */

QPushButton {
    background-color: #252525;
    color: #e0e0e0;
    border: 1px solid #00d4ff;
    border-radius: 4px;
    padding: 6px 16px;
}

QPushButton:hover {
    background-color: #00d4ff;
    color: #000000;
}

QPushButton:pressed {
    background-color: #00a8cc;
    color: #000000;
}

QPushButton:disabled {
    background-color: #1e1e1e;
    color: #606060;
    border-color: #2a2a2a;
}

#ApplyButton {
    background-color: #00d4ff;
    color: #000000;
    border: none;
    font-weight: bold;
}

#ApplyButton:hover {
    background-color: #33ddff;
}

/* ===== Кнопки библиотеки ===== */

#LibraryButton {
    background-color: #252525;
    border: 1px solid #2a2a2a;
    border-radius: 6px;
}

#LibraryButton:hover {
    border-color: #00d4ff;
    background-color: #2a2a2a;
}

#LibraryButton:pressed {
    background-color: #00d4ff;
    color: #000000;
}

/* ===== Выпадающие списки ===== */

QComboBox {
    background-color: #252525;
    color: #e0e0e0;
    border: 1px solid #2a2a2a;
    border-radius: 4px;
    padding: 4px 8px;
}

QComboBox:hover {
    border-color: #00d4ff;
}

QComboBox:focus {
    border-color: #00d4ff;
    border-width: 2px;
}

QComboBox::drop-down {
    border: none;
    width: 20px;
}

QComboBox QAbstractItemView {
    background-color: #252525;
    border: 1px solid #00d4ff;
    selection-background-color: #00d4ff;
    selection-color: #000000;
}

/* ===== Чекбоксы ===== */

QCheckBox {
    color: #e0e0e0;
    spacing: 8px;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border: 2px solid #2a2a2a;
    border-radius: 4px;
    background-color: #1a1a1a;
}

QCheckBox::indicator:hover {
    border-color: #00d4ff;
}

QCheckBox::indicator:checked {
    background-color: #00d4ff;
    border-color: #00d4ff;
}

/* ===== Группы ===== */

QGroupBox {
    border: 1px solid #00d4ff;
    border-radius: 4px;
    margin-top: 12px;
    padding-top: 8px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 8px;
    color: #00d4ff;
}

/* ===== Разделители ===== */

QSplitter::handle {
    background-color: #00d4ff;
}

QSplitter::handle:horizontal {
    width: 2px;
}

QSplitter::handle:vertical {
    height: 2px;
}

/* ===== Диалоги ===== */

QDialog#SettingsWindow {
    background-color: #1e1e1e;
    border: 1px solid #00d4ff;
}

/* ===== Статус-бар ===== */

QStatusBar {
    background-color: #1e1e1e;
    border-top: 1px solid #00d4ff;
    color: #00d4ff;
}

/* ===== Подсказки ===== */

QToolTip {
    background-color: #252525;
    color: #e0e0e0;
    border: 1px solid #00d4ff;
    padding: 4px 8px;
}
